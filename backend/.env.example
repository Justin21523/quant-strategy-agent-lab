QSA_PROJECT_NAME="Quant Strategy Agent Lab API"
QSA_ENVIRONMENT="development"
QSA_API_V1_PREFIX="/api/v1"
QSA_LOG_LEVEL="INFO"
QSA_BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
QSA_MARKET_DATABASE_PATH="backend/data/cache/market_data.sqlite3"
QSA_MARKET_CSV_SEED_DIR="backend/data/seed"
QSA_MARKET_SEED_DEMO_DATA=true
QSA_MARKET_MAX_RESPONSE_BARS=10000
QSA_MARKET_YFINANCE_ENABLED=true
QSA_MARKET_PROVIDER_TIMEOUT_SECONDS=10
# QSA_FINMIND_TOKEN=""
