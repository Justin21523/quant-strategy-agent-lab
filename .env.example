# Application
QSA_ENVIRONMENT=development
QSA_LOG_LEVEL=INFO
QSA_API_PREFIX=/api/v1
QSA_BACKEND_HOST=127.0.0.1
QSA_BACKEND_PORT=8000

# Comma-separated origins accepted by FastAPI CORS middleware.
QSA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vite exposes only variables prefixed with VITE_.
VITE_API_BASE_URL=/api/v1
